# Copiez ce fichier en `.env` puis renseignez vos valeurs.
# La clé d'API reste UNIQUEMENT côté serveur, jamais dans le frontend.

# Clé API Alma (sandbox = sk_test_..., production = sk_live_...)
ALMA_API_KEY=sk_test_3RG9iMTw2oearUHkNCBUUZ3P

# URL de base de l'API Alma
# Sandbox : https://api.sandbox.getalma.eu/v1
# Production : https://api.getalma.eu/v1
ALMA_API_BASE=https://api.sandbox.getalma.eu/v1

# URL de base de l'API Alma en v2 (endpoint shipment)
ALMA_API_BASE_V2=https://api.sandbox.getalma.eu/v2

# Origines autorisées par le CORS (séparées par des virgules)
# Exemple pour React en dev : http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Timeout des appels vers Alma (secondes)
ALMA_TIMEOUT=30

# Vérification TLS (false si un proxy d'entreprise intercepte le HTTPS)
ALMA_SSL_VERIFY=true
